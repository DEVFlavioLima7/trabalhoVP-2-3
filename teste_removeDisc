info_com_tipo criarCursoMock(int codigo, const char* nome) {
    info_com_tipo nova_info;
    nova_info.tipo = TIPO_CURSO; 
    nova_info.dado.curso.codigo_curso = codigo;
    strcpy(nova_info.dado.curso.nome_curso, nome);
    nova_info.dado.curso.qtd_blocos_curso = 8;
    nova_info.dado.curso.raiz_disciplinas = NULL; 
    return nova_info;
}

info_com_tipo criarDisciplinaMock(int codigo, const char* nome) {
    info_com_tipo nova_info;
    nova_info.tipo = TIPO_DISCIPLINA; 
    nova_info.dado.disciplina.codigo_disciplina = codigo;
    strcpy(nova_info.dado.disciplina.nome_disciplina, nome);
    nova_info.dado.disciplina.bloco_disciplina = 1;
    nova_info.dado.disciplina.carga_horaria = 60;
    return nova_info;
}

void destruirArvore(arv_2_3 **raiz) {
    if (*raiz != NULL) {
        destruirArvore(&((*raiz)->esq));
        destruirArvore(&((*raiz)->cen));
        if ((*raiz)->n_infos == 2) destruirArvore(&((*raiz)->dir));
        free(*raiz);
        *raiz = NULL;
    }
}

// ==========================================
// TESTES DE REMOÇÃO DE DISCIPLINAS
// ==========================================
int main() {
    arv_2_3 *raiz_cursos = NULL;
    
    // Cadastramos UM curso base para servir de hospedeiro das disciplinas
    inserirNo23(&raiz_cursos, criarCursoMock(1, "Engenharia de Software"));
    
    // Obtemos o ponteiro para o curso recém-criado
    arv_2_3* no_curso = buscar23(raiz_cursos, 1);
    curso* meu_curso = obterCursoNo23(no_curso, 1);


    printf("\n\n=================================================\n");
    printf(" CENARIO 1: MERGE NA SUB-ARVORE DE DISCIPLINAS\n");
    printf("=================================================\n");
    inserirNo23(&(meu_curso->raiz_disciplinas), criarDisciplinaMock(200, "Calculo 1"));
    inserirNo23(&(meu_curso->raiz_disciplinas), criarDisciplinaMock(100, "Algoritmos"));
    inserirNo23(&(meu_curso->raiz_disciplinas), criarDisciplinaMock(300, "Fisica 1"));
    
    printf("\n[ANTES DA REMOCAO]\n");
    imprimirCursos23(raiz_cursos);
    
    printf("\n>>> Removendo a disciplina 100 (Algoritmos)...\n");
    removerNo23(&(meu_curso->raiz_disciplinas), 100);
    
    printf("\n[DEPOIS DA REMOCAO - Nivel da sub-arvore diminuiu]\n");
    imprimirCursos23(raiz_cursos);
    
    // Limpamos a sub-árvore de disciplinas para o próximo teste
    destruirArvore(&(meu_curso->raiz_disciplinas));


    printf("\n\n=================================================\n");
    printf(" CENARIO 2: REDISTRIBUICAO ENTRE DISCIPLINAS\n");
    printf("=================================================\n");
    inserirNo23(&(meu_curso->raiz_disciplinas), criarDisciplinaMock(200, "Calculo 1"));
    inserirNo23(&(meu_curso->raiz_disciplinas), criarDisciplinaMock(100, "Algoritmos"));
    inserirNo23(&(meu_curso->raiz_disciplinas), criarDisciplinaMock(400, "Algebra"));
    inserirNo23(&(meu_curso->raiz_disciplinas), criarDisciplinaMock(300, "Fisica 1"));
    
    printf("\n[ANTES DA REMOCAO]\n");
    imprimirCursos23(raiz_cursos);
    
    printf("\n>>> Removendo a disciplina 100...\n");
    removerNo23(&(meu_curso->raiz_disciplinas), 100);
    
    printf("\n[DEPOIS DA REMOCAO - Rebalanceou sem perder altura]\n");
    imprimirCursos23(raiz_cursos);
    
    destruirArvore(&(meu_curso->raiz_disciplinas));


    printf("\n\n=================================================\n");
    printf(" CENARIO 3: REMOCAO DA RAIZ DAS DISCIPLINAS\n");
    printf("=================================================\n");
    inserirNo23(&(meu_curso->raiz_disciplinas), criarDisciplinaMock(400, "Banco de Dados"));
    inserirNo23(&(meu_curso->raiz_disciplinas), criarDisciplinaMock(200, "Redes"));
    inserirNo23(&(meu_curso->raiz_disciplinas), criarDisciplinaMock(600, "Sistemas"));
    inserirNo23(&(meu_curso->raiz_disciplinas), criarDisciplinaMock(100, "Logica"));
    inserirNo23(&(meu_curso->raiz_disciplinas), criarDisciplinaMock(300, "Grafos"));
    inserirNo23(&(meu_curso->raiz_disciplinas), criarDisciplinaMock(500, "IA"));
    inserirNo23(&(meu_curso->raiz_disciplinas), criarDisciplinaMock(700, "Compiladores"));
    
    printf("\n[ANTES DA REMOCAO]\n");
    imprimirCursos23(raiz_cursos);
    
    printf("\n>>> Removendo o 400 (Raiz! O 300 deve assumir o Nivel 0 interno)...\n");
    removerNo23(&(meu_curso->raiz_disciplinas), 400);
    
    printf("\n[DEPOIS DA REMOCAO]\n");
    imprimirCursos23(raiz_cursos);
    
    // Limpeza final de tudo
    destruirArvore(&raiz_cursos);

